{
  "ServiceName" : "Decision Mate API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Metrics": {
      "UseRuntimeInstrumentation": true,
      "UseAspNetCoreInstrumentation": true,
      "UseHttpClientInstrumentation": true,
      "Meters": [
        "Microsoft.AspNetCore.Hosting",
        "Microsoft.AspNetCore.Server.Kestrel",
        "System.Net.Http"
      ]
    },
    "Tracing": {
      "UseAspNetCoreInstrumentation": true,
      "UseHttpClientInstrumentation": true,
      "UseEntityFrameworkCoreInstrumentation": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "JwtAuth" : {
    "MetadataAddress" : ""
  },
  "TheMovieDbOptions": {
    "CategoryName": "Movies",
    "MovieEndpointUrl" : "https://api.themoviedb.org/3/discover/movie",
    "GenreEndpointUrl" : "https://api.themoviedb.org/3/genre/movie/list"
  }
}
